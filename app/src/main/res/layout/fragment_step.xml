<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- STEP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tv_step_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"/>

            <TextView
                android:id="@+id/tv_step_title_kn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/gray_mid"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_audio"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_volume_off"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="Toggle Audio"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_call_sos"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="108"
            android:textColor="@color/white"
            android:backgroundTint="@color/red_primary"
            android:textStyle="bold"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressTint="@color/red_primary"
        android:progressBackgroundTint="@color/gray_light"
        android:max="100"/>

    <!-- VIEWPAGER2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_steps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- STEP COUNTER -->
    <TextView
        android:id="@+id/tv_step_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STEP 1 OF 3"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/gray_mid"
        android:letterSpacing="0.1"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"/>

    <!-- DONE BANNER -->
    <LinearLayout
        android:id="@+id/layout_done_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_light"
        android:orientation="vertical"
        android:padding="13dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Steps Complete!"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/green_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call 108 immediately and rush to hospital."
            android:textSize="12sp"
            android:textColor="@color/green_dark"
            android:layout_marginTop="3dp"/>
    </LinearLayout>

    <!-- NAVIGATION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:paddingTop="6dp">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="← Prev"
            android:textStyle="bold"
            android:backgroundTint="@color/white"
            android:textColor="@color/gray_dark"
            android:strokeColor="@color/gray_light"
            android:layout_marginEnd="6dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Next →"
            android:textStyle="bold"
            android:backgroundTint="@color/red_primary"
            android:textColor="@color/white"/>
    </LinearLayout>

</LinearLayout>
